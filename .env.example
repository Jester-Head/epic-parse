# Copy this file to .env and fill in your password. .env is git-ignored.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=epic_parse

# Free Raider.IO app key (raider.io/settings/apps); optional, raises the rate limit
RAIDERIO_KEY=

# Blizzard API client (develop.battle.net), for `fetch bnet`
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# User agent for the forums, Raider.IO and the Blizzard API (default: EpicParse/0.2)
HTTP_USER_AGENT=
