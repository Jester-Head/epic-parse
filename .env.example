# Copy this file to .env and fill in your password. .env is git-ignored.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=epic_parse

# Free Raider.IO app key (raider.io/settings/apps); optional, raises the rate limit
RAIDERIO_KEY=

# Blizzard API client (develop.battle.net), for `fetch bnet`
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Reddit app (reddit.com/prefs/apps), for `fetch reddit`. User agent format Reddit asks for:
# <platform>:<app name>:<version> (by /u/<your username>)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
